# ─────────────────────────────────────────────────────────────────────────────
# LogVault — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core infrastructure ──────────────────────────────────────────────────────
POSTGRES_USER=logvault
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=logvault
# Used by api + worker (points at the `postgres` compose service)
DATABASE_URL=postgresql+psycopg://logvault:change-me-in-production@postgres:5432/logvault

# Used by api + worker (points at the `redis` compose service)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Secrets ──────────────────────────────────────────────────────────────────
# Fernet key for encrypting Last9 refresh tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAST9_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Signing key for API JWT sessions (admin-provisioned accounts).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-random-secret

# ── Last9 defaults (configurable, not hard-coded) ────────────────────────────
DEFAULT_ORG_SLUG=evergentapse1
LAST9_API_BASE=https://app.last9.io/api/v4

# ── API behaviour ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (the web app)
CORS_ORIGINS=http://localhost:3000

# ── Last9 vs New Relic comparisons ──────────────────────────────────────────
# Comparisons run inline in the API: a Last9 aggregate + a New Relic NRQL
# query. Keep the window bounded so a wide query can't hold a request open.
COMPARISON_MAX_WINDOW_DAYS=31
COMPARISON_QUERY_TIMEOUT_SECONDS=60
# New Relic connections are added in the UI (account id + User API key); the
# key is encrypted with LAST9_ENCRYPTION_KEY like the Last9 refresh tokens.

# Where generated CSVs are written (local disk; mounted volume in compose)
STORAGE_DIR=/data/exports
DOWNLOAD_URL_TTL_SECONDS=604800   # 7 days
EXPORT_RETENTION_DAYS=30
# A parse regex entered manually on a saved search, job or schedule is also
# added to the Log Formats library (deduped by pattern, priority 500, after
# curated formats). Set false to keep the library hand-curated only.
AUTO_REGISTER_FORMATS=true
# Wrap Excel-coerced values (long ids, timestamps) as ="..." so a spreadsheet
# keeps them literal. Leave OFF when the CSVs are loaded into a warehouse —
# that `=` and the quotes are ingested as data. Turn ON only for spreadsheet
# workflows, where Excel would otherwise turn 230702032635917346995349 into
# 2.30702E+23 and reformat timestamps.
EXCEL_ESCAPE=false
# Refuse to start a job below this much free space. Exports and pgdata share one
# filesystem, so a run that fills the disk stops Postgres writing too.
MIN_FREE_DISK_GB=10
# A `running` job silent for this long is presumed dead and marked failed.
STALE_JOB_MINUTES=60
# A task redelivered by the broker (its worker died) may take over a `running`
# job once it has been quiet this long, resuming from the checkpoint. Keep it
# above the runner's 5-minute heartbeat.
STALE_RECLAIM_MINUTES=10

# Extraction slots: how many jobs stream at once. The rest queue. Raising this
# increases Last9 request volume and per-process memory. Also adjustable live
# from Admin → Worker capacity (that change is lost on restart).
WORKER_CONCURRENCY=4
# How often the worker samples CPU/memory/disk for health alerts, in seconds.
HEALTH_CHECK_INTERVAL_SECONDS=60

# Where nightly pg_dumps land. A HOST path, not a named volume: `docker compose
# down -v` deletes named volumes, backups included. Point this at durable
# storage in prod, and copy it off the box.
BACKUP_DIR=./backups
BACKUP_STALE_HOURS=36              # /health/ops complains past this
WORKER_BEAT_STALE_SECONDS=300      # /health/ops complains past this

# Login throttle: failures per email before a lockout, and how long it lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Empty client id/secret disables it and the login page shows password auth
# only. To enable: create an OAuth client (see INSTALL.md), then set:
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Comma-separated Workspace domains allowed to sign in (empty = any verified
# Google account). Set this before exposing the app beyond a trusted network.
#GOOGLE_ALLOWED_DOMAINS=
# Public bases. The redirect URI sent to Google is
# {PUBLIC_API_BASE_URL}/auth/google/callback and must match an Authorized
# redirect URI in the Google Cloud console exactly.
PUBLIC_API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3001

# ── Web (Next.js) ────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
